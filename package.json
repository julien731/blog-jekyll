{
  "name": "julien-liabeuf",
  "version": "3.0.0",
  "description": "A minimal, type-focused Jekyll theme.",
  "scripts": {
    "sass": "sass assets/scss/style.scss:assets/css/style.css --style=compressed",
    "sass:watch": "sass assets/scss/style.scss:assets/css/style.css --style=compressed --watch",
    "jekyll": "bundle exec jekyll serve --livereload",
    "dev": "npm run sass && npm run sass:watch & npm run jekyll",
    "build": "npm run sass && bundle exec jekyll build"
  },
  "author": "Julien Liabeuf",
  "license": "MIT",
  "devDependencies": {
    "@netlify/plugin-lighthouse": "^6.0.0",
    "sass": "^1.77.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/julien731/blog-jekyll.git"
  },
  "keywords": [
    "jekyll",
    "sass"
  ]
}
